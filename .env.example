# =====================================================================
#  WanderSync - variables de entorno
#  Copia este archivo a .env  (o ejecuta:  python3 scripts/init_env.py)
#  y completa SOLO las 3 variables de Supabase. Los secretos internos
#  los genera init_env.py de forma aleatoria.
# =====================================================================

# ---- Supabase Cloud (catalogo scrapeado + GraphQL nativo) -----------
# Project URL, sin barra final. Ej: https://abcdxyz.supabase.co
SUPABASE_URL=
# Clave publica: "publishable" (sb_publishable_...) o legacy "anon". Solo lectura via RLS.
SUPABASE_ANON_KEY=
# Clave secreta: "secret" (sb_secret_...) o legacy "service_role". SOLO ingesta. Nunca al frontend.
SUPABASE_SERVICE_KEY=

# ---- Secretos internos (los rellena init_env.py) ---------------------
POSTGRES_PASSWORD=
FLIGHTS_DB_PASSWORD=
HOTELS_DB_PASSWORD=
CARS_DB_PASSWORD=
ORDERS_DB_PASSWORD=
AUTH_DB_PASSWORD=
REDIS_PASSWORD=
# Token compartido entre microservicios (autenticacion servicio-a-servicio)
INTERNAL_TOKEN=

# ---- Comportamiento --------------------------------------------------
# true solo si sirves el sitio por HTTPS
COOKIE_SECURE=false
# Permite forzar fallos SAGA desde la UI (modo demo). PONER false en produccion.
ALLOW_FAILURE_SIMULATION=true
# Modo presentacion ("paso a paso" en el checkout): pausa por paso de la SAGA, en ms (max 5000)
DEMO_STEP_DELAY_MS=2500
# Interfaz GraphiQL del gateway (util para la sustentacion). false en produccion.
GRAPHIQL=true

# ---- Fuente simulada (mock) ------------------------------------------
# Probabilidad de que el sitio simulado falle (500/503/429) para probar reintentos de Prefect
MOCK_FAILURE_RATE=0.10

# ---- Ingesta (Prefect + Dask) ----------------------------------------
# Frecuencia del flow programado (cron). La primera ingesta corre al arrancar.
INGEST_CRON="*/30 * * * *"
# Fechas de salida a raspar, en dias desde hoy
INGEST_DATE_OFFSETS=7,14,21,28
# Noches de estancia (hoteles) / dias de alquiler (autos)
INGEST_STAY_NIGHTS=3
