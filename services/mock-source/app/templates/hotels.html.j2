<!doctype html>
<html lang="es">
<head>{% include "_layout_head.html.j2" %}<title>Hoteles en {{ city_name }} - MockTravel</title></head>
<body>
<header class="site"><a href="/">MockTravel</a></header>
<main class="results-page" data-vertical="hotels" data-total-results="{{ total }}">
  <h1 class="search-title">Hoteles en <span class="city">{{ city_name }}</span></h1>
  <p class="search-meta">Entrada {{ checkin }} &middot; {{ nights }} noches &middot; {{ total }} resultados</p>
  {% if not items %}<p class="empty">No encontramos hoteles para esta búsqueda.</p>{% endif %}
  <ol class="results">
  {% for it in items %}
    <li class="result-card hotel" data-offer-id="{{ it.offer_id }}">
      <div><h2 class="hotel-name">{{ it.name }}</h2>
        <span class="stars" aria-label="{{ it.stars }} estrellas">{{ "★" * it.stars }}</span></div>
      <div>Puntuación <span class="score">{{ it.rating_text }}</span></div>
      <ul class="amenities">{% for a in it.amenities %}<li>{{ a }}</li>{% endfor %}</ul>
      <div class="rate"><span class="price">{{ it.price_text }}</span> <span class="unit">por noche</span></div>
    </li>
  {% endfor %}
  </ol>
  {% include "_pagination.html.j2" %}
</main>
</body>
</html>
