<!doctype html>
<html lang="es">
<head>{% include "_layout_head.html.j2" %}<title>Autos en {{ city_name }} - MockTravel</title></head>
<body>
<header class="site"><a href="/">MockTravel</a></header>
<main class="results-page" data-vertical="cars" data-total-results="{{ total }}">
  <h1 class="search-title">Alquiler de autos en <span class="city">{{ city_name }}</span></h1>
  <p class="search-meta">Recogida {{ pickup }} &middot; {{ days }} días &middot; {{ total }} resultados</p>
  {% if not items %}<p class="empty">No encontramos autos para esta búsqueda.</p>{% endif %}
  <ol class="results">
  {% for it in items %}
    <li class="result-card car" data-offer-id="{{ it.offer_id }}">
      <div><span class="company">{{ it.company }}</span><br><span class="model">{{ it.model }}</span></div>
      <div><span class="category">{{ it.category }}</span> &middot; <span class="transmission">{{ it.transmission }}</span></div>
      <div class="seats">{{ it.seats_text }}</div>
      <div class="rate"><span class="price">{{ it.price_text }}</span> <span class="unit">por día</span></div>
    </li>
  {% endfor %}
  </ol>
  {% include "_pagination.html.j2" %}
</main>
</body>
</html>
